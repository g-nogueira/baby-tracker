{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baby-tracker.local/contracts/sync-request-v1.schema.json",
  "title": "Baby Tracker sync request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "deviceId", "afterSequence", "operations"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "deviceId": { "type": "string", "format": "uuid" },
    "afterSequence": { "type": "integer", "minimum": 0 },
    "operations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "entityType",
        "entityId",
        "action",
        "baseVersion",
        "clientOccurredAt",
        "clientTimezone",
        "payload"
      ],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "entityType": {
          "enum": ["sleep_session", "nursing_session", "care_event"]
        },
        "entityId": { "type": "string", "format": "uuid" },
        "action": { "type": "string", "minLength": 1 },
        "baseVersion": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "clientOccurredAt": { "type": "string", "format": "date-time" },
        "clientTimezone": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      }
    }
  }
}
