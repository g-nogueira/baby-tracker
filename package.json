{
  "name": "baby-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "mobile": "pnpm --filter @baby-tracker/mobile start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @baby-tracker/domain typecheck && pnpm --filter @baby-tracker/mobile typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
